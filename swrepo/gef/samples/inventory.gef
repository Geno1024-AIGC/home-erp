==== ui ====
{
  "type": "page",
  "title": "库存",
  "children": [
    {
      "type": "text",
      "text": "我的家居物品"
    },
    {
      "type": "list",
      "repeat": "items",
      "item": {
        "type": "row",
        "children": [
          {
            "type": "image",
            "src": "icon"
          },
          {
            "type": "text",
            "bind": "item.name"
          },
          {
            "type": "text",
            "bind": "item.qty"
          },
          {
            "type": "text",
            "bind": "item.location"
          }
        ]
      }
    },
    {
      "type": "button",
      "label": "添加物品",
      "action": "url:POST /api/inventory/items"
    }
  ]
}
